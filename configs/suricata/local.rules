# Custom Suricata rules used in the lab
# Use only in an authorized test environment.

alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible Nmap Scan Detected - Multiple SYN packets"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:9000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"CUSTOM Possible SSH Brute Force Attempt"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000002; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"CUSTOM Possible ICMP Flood / Ping Sweep"; itype:8; threshold:type both, track by_src, count 30, seconds 10; classtype:attempted-dos; sid:9000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible SYN Flood DoS Attack"; flags:S; threshold:type both, track by_src, count 100, seconds 5; classtype:attempted-dos; sid:9000004; rev:1;)
